PORT=3010
# Premier administrateur : utilisé UNIQUEMENT au tout premier démarrage (création du compte).
# Ensuite, gérez les comptes et mots de passe dans l'application (Paramètres).
APP_USER=admin
APP_PASSWORD=ChangezMoi-Mot-de-passe-solide
# Indicatif ajouté aux numéros saisis sans "+" (ex: 237 pour le Cameroun). Laisser vide pour désactiver.
DEFAULT_COUNTRY_CODE=237
# Nombre maximum de messages par envoi (protection anti-blocage)
MAX_PER_RUN=300
